# Public Supabase project URL.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Preferred browser-safe Supabase publishable key (sb_publishable_...).
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-PUBLISHABLE-KEY

# Legacy browser-safe anon key fallback only, if required by the existing Supabase project.
# Leave blank when VITE_SUPABASE_PUBLISHABLE_KEY is configured.
VITE_SUPABASE_ANON_KEY=

# Optional: exact real public HTTPS origin after the production domain is confirmed.
# Do not use a placeholder/example domain in a production build.
VITE_SITE_URL=
