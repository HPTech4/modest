# Public Supabase project URL. This is not a service-role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable/anon key. Keep RLS enabled on every application table.
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-PUBLISHABLE-OR-ANON-KEY

# Optional public canonical site URL for canonical/social metadata.
VITE_SITE_URL=https://your-store-domain.example
